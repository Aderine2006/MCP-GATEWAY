              "value": "created",
              "type": "string"
            },
            {
              "id": "health_status",
              "name": "health_status",
              "value": "healthy",
              "type": "string"
            },
            {
              "id": "message",
              "name": "message",
              "value": "MCP server created successfully",
              "type": "string"
            }
          ]
        },
        "name": "Set Success Response",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.2,
        "position": [1450, 400]
    },
    {
      "parameters": {},
      "name": "Respond to Webhook",
